# ─────────────────────────────────────────────────────────
# EUPI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=kifiya-dev-secret-CHANGE-IN-PRODUCTION
JWT_TOKEN_TTL_SECONDS=3600

# ── Database ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./kifiya_gateway.db

# ── Bank CBS API Keys ────────────────────────────────────
COOP_CBS_API_KEY=mock-coop-key
CBE_CBS_API_KEY=mock-cbe-key
WEGAGEN_CBS_API_KEY=mock-wegagen-key

# ── Fayda Identity ───────────────────────────────────────
FAYDA_API_BASE_URL=https://api.fayda.et/v1
FAYDA_CLIENT_ID=your-kifiya-client-id
FAYDA_CLIENT_SECRET=your-kifiya-client-secret

# ── Smart Router Weights (must sum to 1.0) ───────────────
ROUTER_WEIGHT_UPTIME=0.50
ROUTER_WEIGHT_LATENCY=0.30
ROUTER_WEIGHT_COST=0.20

# ── General ──────────────────────────────────────────────
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://127.0.0.1:8080
