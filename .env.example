# ─────────────────────────────────────────────────────────
# EUPI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# With DEBUG=false the app validates this configuration at import time and
# refuses to start on a known-default secret, a wildcard CORS origin, or
# router weights that do not sum to 1.0. See backend/config.py.
# ─────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# The value below is a known default and is REFUSED when DEBUG=false.
JWT_SECRET_KEY=kifiya-dev-secret-CHANGE-IN-PRODUCTION
JWT_TOKEN_TTL_SECONDS=3600

# ── Admin Portal ─────────────────────────────────────────
# Session lifetime for operator logins (default 8 hours).
ADMIN_SESSION_TTL_SECONDS=28800

# Seeds the first admin operator, and only when no operator exists yet.
# There is no unauthenticated path into the Admin API, so without these the
# portal cannot be reached on a fresh database.
ADMIN_BOOTSTRAP_EMAIL=admin@kifiya.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-any-shared-deployment

# ── PIN Security ─────────────────────────────────────────
# Consecutive failed PIN attempts before an account locks, and for how long.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900

# ── National ID Vault ────────────────────────────────────
# Fayda numbers are encrypted at rest. FIN_ENCRYPTION_KEY encrypts them;
# FIN_BLIND_INDEX_PEPPER keys the deterministic index that makes an encrypted
# value searchable, so "one account per national ID" can be enforced without
# decrypting anything.
#
# Both values below are known defaults and are REFUSED when DEBUG=false —
# encryption with a published key protects nothing. Generate real ones with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Changing either on a populated database is a ONE-WAY DOOR: a new encryption
# key makes existing ciphertext unreadable, and a new pepper makes existing
# accounts unfindable by FIN. Rotation needs a re-encryption pass.
FIN_ENCRYPTION_KEY=kifiya-dev-fin-encryption-key-DO-NOT-USE-IN-PRODUCTION
FIN_BLIND_INDEX_PEPPER=kifiya-dev-blind-index-pepper-DO-NOT-USE-IN-PRODUCTION

# ── Consent ──────────────────────────────────────────────
# Default lifetime of a scope a user grants to a developer application.
# Bounded so a forgotten integration eventually stops reading their data.
CONSENT_DEFAULT_TTL_DAYS=365

# ── Database ─────────────────────────────────────────────
# SQLite is fine for local development. Postgres is required for anything
# else: SQLite serialises writers behind one lock and has no real decimal
# type, and the ledger needs both concurrency and exact NUMERIC arithmetic.
#   postgresql+psycopg://user:password@host:5432/eupi
#
# Schema changes are applied with Alembic, never create_all:
#   alembic upgrade head
DATABASE_URL=sqlite:///./kifiya_gateway.db

# ── Bank CBS API Keys ────────────────────────────────────
COOP_CBS_API_KEY=mock-coop-key
CBE_CBS_API_KEY=mock-cbe-key
WEGAGEN_CBS_API_KEY=mock-wegagen-key
AWASH_CBS_API_KEY=mock-awash-key
ABYSSINIA_CBS_API_KEY=mock-abyssinia-key
BERHAN_CBS_API_KEY=mock-berhan-key

# ── Fayda Identity ───────────────────────────────────────
FAYDA_API_BASE_URL=https://api.fayda.et/v1
FAYDA_CLIENT_ID=your-kifiya-client-id
FAYDA_CLIENT_SECRET=your-kifiya-client-secret

# ── Smart Router Weights (must sum to 1.0) ───────────────
ROUTER_WEIGHT_UPTIME=0.50
ROUTER_WEIGHT_LATENCY=0.30
ROUTER_WEIGHT_COST=0.20

# ── General ──────────────────────────────────────────────
DEBUG=true
# A wildcard '*' is REFUSED when DEBUG=false — browsers reject it alongside
# credentialed requests, and it defeats CORS entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
